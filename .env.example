# Copy to .env and adjust. .env is git-ignored; never commit real keys.

# --- server ---------------------------------------------------------------
APP_ENV=development
# 127.0.0.1 = only this machine. Use 0.0.0.0 to accept connections from the network (Docker sets this).
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
LOG_JSON=true
# Include (truncated) prompt text in logs. Keep false unless debugging locally.
LOG_PROMPTS=false

# --- cache ----------------------------------------------------------------
# Cosine similarity needed for a HIT. There is no universally right value: tune it on
# your own traffic (see docs/evaluation.md). Higher = fewer wrong answers, fewer hits.
CACHE_SIMILARITY_THRESHOLD=0.90
CACHE_TTL_SECONDS=3600
CACHE_MAX_ENTRIES=10000
CACHE_TOP_K=5
# Background purge of expired entries (0 disables; expired entries are never served anyway).
CACHE_CLEANUP_INTERVAL_SECONDS=60
# Requests with temperature above this bypass the cache (creative output shouldn't be reused).
CACHE_MAX_TEMPERATURE=1.0
# Directory to persist the cache across restarts (saved on shutdown). Empty = memory only.
VECTOR_STORE_PATH=./data/vector_store

# --- embeddings -----------------------------------------------------------
# hashing               : built-in, deterministic, offline, lexical (default; used by tests)
# sentence-transformers : local neural model; pip install -e ".[sentence-transformers]"
# openai                : OpenAI-compatible /embeddings endpoint (needs OPENAI_API_KEY)
EMBEDDING_PROVIDER=hashing
EMBEDDING_DIMENSIONS=512
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- LLM provider ---------------------------------------------------------
# mock   : deterministic fake LLM, no network, no cost
# openai : any OpenAI-compatible /chat/completions endpoint
LLM_PROVIDER=mock
LLM_DEFAULT_MODEL=mock-1
LLM_TIMEOUT_SECONDS=30
MOCK_LLM_LATENCY_MS=800
# OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1

# --- cost estimation (USD per 1K tokens; estimates only, not billing data) -
COST_PER_1K_INPUT_TOKENS=0.00015
COST_PER_1K_OUTPUT_TOKENS=0.0006

# --- security -------------------------------------------------------------
MAX_MESSAGE_CHARS=8000
MAX_REQUEST_BYTES=64000
# Comma-separated browser origins allowed by CORS. Empty = CORS disabled.
CORS_ALLOW_ORIGINS=
# Comma-separated client keys. If set, /v1/* and /metrics require header X-API-Key.
API_KEYS=
